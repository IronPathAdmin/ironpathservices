---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceTree from '../components/ServiceTree.astro';
import ContactForm from '../components/ContactForm.astro';
import GoogleFormLinks from '../components/GoogleFormLinks.astro';
import { contact, faqs, googleForms, reviews, serviceAreas } from '../data/site';
---

<BaseLayout title="Iron Path Services | Methow Valley" description="A complete Iron Path Services website overhaul for Methow Valley services, community initiatives, pricing, reviews, and quotes.">
  <section class="hero" style="--hero-image: url('/assets/img-firewood.jpg');">
    <div class="hero-content">
      <div class="eyebrow">Methow Valley's Trusted Team</div>
      <h1>A path forged <em>in trust.</em></h1>
      <p class="lead">
        Junk removal, cleaning, secure shredding, firewood, vending, and ATMs - delivered by
        people who live here, work here, and plan to stay.
      </p>
      <div class="hero-actions">
        <a class="btn" href="/get-a-quote/">Get a Free Quote</a>
        <a class="btn secondary" href={contact.phoneHref}>Call {contact.phone}</a>
      </div>
    </div>
  </section>

  <section class="container">
    <div class="notice-row">
      <div class="notice"><strong>Fuel Surcharge Notice</strong><span>Fuel charges are tied to Winthrop gas prices and disclosed before booking.</span></div>
      <div class="notice"><strong>Transparency Notice</strong><span>No hidden fees. You approve itemized pricing before work begins.</span></div>
      <div class="notice"><strong>Community Donation Pledge</strong><span>A meaningful share of profits is pledged back into Methow Valley needs.</span></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="eyebrow">Living Services Tree</div>
      <h2>Every service is a <em>branch</em> of the same promise.</h2>
      <p class="lead">
        The tree is decorative; the cards contain the accessible service information. On mobile,
        the branches stack for easy reading.
      </p>
      <ServiceTree />
    </div>
  </section>

  <section class="section sand">
    <div class="container grid two" style="align-items: center;">
      <div>
        <div class="eyebrow">Where We Serve</div>
        <h2>13 communities <em>and counting.</em></h2>
        <p class="lead">Based in Winthrop, serving the Methow Valley and Okanogan County.</p>
        <ul class="pill-list">
          {serviceAreas.map((area) => <li>{area}</li>)}
        </ul>
        <div class="form-note">
          Winthrop & Twisp: no travel fee. Mazama/Carlton: +$30. Brewster/Pateros: +$60.
          Beyond 60 miles from Winthrop: $2.25/mile. All fees disclosed upfront.
        </div>
      </div>
      <div class="image-card" style="background-image: url('/assets/img-wrecked.jpg');" role="img" aria-label="Placeholder Methow Valley service area image"></div>
    </div>
  </section>

  <section class="section">
    <div class="container grid three">
      <div class="card reveal">
        <h3>What to Expect</h3>
        <p>Fast response, written pricing, scheduled arrival windows, before-and-after photos, and respectful follow-up after the job.</p>
      </div>
      <div class="card reveal">
        <h3>What We Do Not Do</h3>
        <p>No hazardous materials, biohazard waste, asbestos, heavy construction debris, plumbing, electrical, or trade-licensed work.</p>
      </div>
      <div class="card reveal">
        <h3>The Green Initiative</h3>
        <p>We refurbish reusable items, reclaim safe firewood, and turn paper waste into recycled fire starter blocks.</p>
      </div>
    </div>
  </section>

  <section class="section dark">
    <div class="container">
      <div class="eyebrow">Common Questions</div>
      <h2>FAQ</h2>
      <div class="grid two" style="margin-top: 28px;">
        {faqs.slice(0, 6).map(([question, answer]) => (
          <div class="card reveal">
            <h3>{question}</h3>
            <p>{answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section sand">
    <div class="container">
      <div class="eyebrow">Reviews</div>
      <h2>What people <em>say.</em></h2>
      <div class="grid four" style="margin-top: 28px;">
        {reviews.map((review) => (
          <div class="card reveal">
            <p style="font-family: 'Lora', Georgia, serif; font-style: italic;">"{review.quote}"</p>
            <strong>{review.name}</strong><br />
            <span>{review.location} · {review.service}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container grid two" style="align-items: start;">
      <div>
        <div class="eyebrow">Get Started</div>
        <h2>Request a free <em>estimate.</em></h2>
        <p class="lead">
          Send the details once. We will route the request for email review now and connect Google
          Forms once your Workspace form URLs are ready.
        </p>
      </div>
      <ContactForm type="quote" title="Tell Us About Your Job" googleFormUrl={googleForms.generalQuote} />
    </div>
  </section>

  <section class="section sand compact">
    <div class="container">
      <div class="eyebrow">Official Google Forms</div>
      <h2>Choose the fastest <em>request path.</em></h2>
      <GoogleFormLinks
        columns="four"
        titles={[
          'General Service Quote Request',
          'Firewood Order',
          'Vending / ATM Placement Inquiry',
          'Secure Paper Shredding',
        ]}
      />
    </div>
  </section>
</BaseLayout>
