---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceTree from '../components/ServiceTree.astro';
import TallyEmbed from '../components/TallyEmbed.astro';
import GoogleFormLinks from '../components/GoogleFormLinks.astro';
import ReviewCard from '../components/ReviewCard.astro';
import { communityPledge, contact, faqs, promotions, reviews, serviceAreas, servicePromise, serviceTagline, travelFeeNote } from '../data/site';
---

<BaseLayout title="Iron Path Services | Methow Valley" description={`${serviceTagline} ${servicePromise}`}>
  <section class="hero" style="--hero-image: url('/assets/img-firewood.jpg');">
    <div class="hero-content">
      <div class="eyebrow">Methow Valley's Trusted Team</div>
      <h1>A path forged <em>in trust.</em></h1>
      <p class="lead">
        {serviceTagline} {servicePromise}
      </p>
      <div class="hero-actions">
        <a class="btn" href="/get-a-quote/">Get a Free Quote</a>
        <a class="btn secondary" href={contact.phoneHref}>Call {contact.phone}</a>
      </div>
    </div>
  </section>

  <section class="container">
    <div class="notice-row">
      <div class="notice"><strong>Fuel Surcharge Notice</strong><span>Fuel charges are tied to Winthrop gas prices and disclosed before booking.</span></div>
      <div class="notice"><strong>Transparency Notice</strong><span>No hidden fees. You approve itemized pricing before work begins.</span></div>
      <div class="notice"><strong>{communityPledge.title}</strong><span>{communityPledge.summary}</span></div>
    </div>
  </section>

  {promotions.length > 0 && (
    <section class="section home-promo-banner-section">
      <div class="container home-promo-banner">
        <div class="home-promo-banner-heading">
          <div class="eyebrow">Current Promotions</div>
          <h2>Two ways to <em>save or win.</em></h2>
          <p class="lead">
            Claim the $150 FIRST30 launch special or enter the Iron Path Giveaway. Full terms
            are posted on the pricing page.
          </p>
          <a class="btn secondary" href="/pricing/">See Promotion Details</a>
        </div>
        <div class="home-promo-banner-grid">
          {promotions.map((promotion) => (
            <article class={`home-promo-banner-card${promotion.promoCode === 'FIRST30' ? ' featured' : ''}`}>
              {promotion.status && <p class="promotion-status">{promotion.status}</p>}
              <h3>{promotion.title}</h3>
              <p>{promotion.details}</p>
              {promotion.promoCode && (
                <div class="home-promo-code" aria-label={`${promotion.title} promo code`}>
                  <span>Promo code</span>
                  <strong>{promotion.promoCode}</strong>
                </div>
              )}
              {promotion.dates && (
                <ul class="home-promo-meta">
                  {promotion.dates.slice(0, 2).map((date) => (
                    <li><span>{date.label}</span><strong>{date.value}</strong></li>
                  ))}
                </ul>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section sand sustainable-section promise-roadmap-section">
    <div class="container sustainable-panel promise-roadmap-panel">
      <div class="promise-intro">
        <div class="eyebrow">Our Promise to the Methow</div>
        <p class="promise-kicker">The Iron Path Valley Roadmap &middot; 2026-2030</p>
        <h2>We wrote a <em>scoreboard.</em></h2>
        <p class="lead">
          We are not a franchise. We are not passing through. We live here, we work here,
          and we plan to stay. This is our public commitment to the Methow Valley - with
          real numbers, real deadlines, and a public scoreboard. Hold us to it.
        </p>
        <p class="status-note">
          Every item below carries a status:
          <span class="roadmap-status done" aria-label="Done">&#10003;</span> Done &middot;
          <span class="roadmap-status in-progress" aria-label="In Progress">&#9679;</span> In Progress &middot;
          <span class="roadmap-status planned" aria-label="Planned">&#9675;</span> Planned.
          This page updates as we deliver.
        </p>
        <div class="sustainable-actions">
          <a class="btn" href="/get-a-quote/">Get a Free Quote</a>
          <a class="btn secondary" href="/investment-tracker/">See the Investment Tracker</a>
          <a class="btn secondary" href="/initiatives/">Join a Cleanup Day</a>
        </div>
      </div>

      <div class="promise-numbers">
        <span class="promise-numbers-label">The numbers we are chasing</span>
        <h3>By December 31, 2030, Iron Path Services will have:</h3>
        <ul class="promise-metric-list">
          <li><strong>250,000+ lbs</strong><span>of material kept out of the landfill</span></li>
          <li><strong>$25,000+</strong><span>reinvested directly into Methow Valley needs</span></li>
          <li><strong>20+ cleanup days</strong><span>completed with the community</span></li>
          <li><strong>5+ local jobs</strong><span>created, hired from the valley and paid fairly</span></li>
          <li><strong>100% published</strong><span>profits-pledge dollars shown line by line on the public Investment Tracker</span></li>
        </ul>
        <p>That is the destination. Here is the path.</p>
      </div>

      <div class="roadmap-year-grid">
        <article class="roadmap-year-card reveal">
          <div class="roadmap-year-heading">
            <span>2026</span>
            <h3>The Founding Year</h3>
            <p>Earn trust. Prove the model. Show our work.</p>
          </div>
          <ul class="roadmap-list">
            <li><span class="roadmap-status in-progress" aria-label="In Progress">&#9679;</span><div><strong>Donation-first sorting on every junk job.</strong> Before anything hits a landfill, it gets a second look: donate, refurbish, reclaim, recycle. Goal: <strong>15,000 lbs diverted in year one.</strong></div></li>
            <li><span class="roadmap-status in-progress" aria-label="In Progress">&#9679;</span><div><strong>3% of net profit pledged to the valley</strong> - every dollar published on the live Investment Tracker the month it is given.</div></li>
            <li><span class="roadmap-status planned" aria-label="Planned">&#9675;</span><div><strong>Launch Blazers&trade; fire starters</strong> - made from recycled valley paper waste and local sawdust. Waste in, warmth out.</div></li>
            <li><span class="roadmap-status planned" aria-label="Planned">&#9675;</span><div><strong>2 community cleanup days</strong> before the year ends - riverbank, trailhead, or a neighbor in need. The community picks the targets.</div></li>
            <li><span class="roadmap-status planned" aria-label="Planned">&#9675;</span><div><strong>Founding partner network of 10 local businesses</strong> - cross-referrals so no job in the valley goes unanswered.</div></li>
            <li><span class="roadmap-status planned" aria-label="Planned">&#9675;</span><div><strong>First Karaoke hosting night with complimentary Red Carpet Moments</strong> - celebrating the people who make this valley what it is. <a href="/karaoke/">See Karaoke Hosting</a>.</div></li>
          </ul>
        </article>

        <article class="roadmap-year-card reveal">
          <div class="roadmap-year-heading">
            <span>2027</span>
            <h3>The Proof Year</h3>
            <p>Publish the receipts. Put locals in charge of our giving.</p>
          </div>
          <ul class="roadmap-list">
            <li><span class="roadmap-status planned" aria-label="Planned">&#9675;</span><div><strong>First annual Valley Impact Report</strong> - pounds diverted, dollars given, hours volunteered. Public, plain-language, every year after.</div></li>
            <li><span class="roadmap-status planned" aria-label="Planned">&#9675;</span><div><strong>First Iron Path Community Grant: $1,000 minimum.</strong> Locals nominate. Locals vote. We just write the check.</div></li>
            <li><span class="roadmap-status planned" aria-label="Planned">&#9675;</span><div><strong>Cumulative diversion goal: 50,000 lbs.</strong></div></li>
            <li><span class="roadmap-status planned" aria-label="Planned">&#9675;</span><div><strong>4 community cleanup days</strong>, on a published seasonal calendar.</div></li>
            <li><span class="roadmap-status planned" aria-label="Planned">&#9675;</span><div><strong>High Schooler Work Program launches</strong> - paid hands-on experience, mentorship, and a reference letter for <strong>3-5 Methow Valley students.</strong></div></li>
            <li><span class="roadmap-status planned" aria-label="Planned">&#9675;</span><div><strong>Blazers&trade; in its first 3 local retail locations.</strong></div></li>
          </ul>
        </article>

        <article class="roadmap-year-card reveal">
          <div class="roadmap-year-heading">
            <span>2028</span>
            <h3>The Growth Year</h3>
            <p>Create jobs. Reach the whole county. Give back bigger.</p>
          </div>
          <ul class="roadmap-list">
            <li><span class="roadmap-status planned" aria-label="Planned">&#9675;</span><div><strong>First full-time local hire</strong> - a real job, fair pay, hired from the valley.</div></li>
            <li><span class="roadmap-status planned" aria-label="Planned">&#9675;</span><div><strong>Free Senior &amp; Veteran Cleanout Days: 10 properties per year</strong>, no charge, no strings.</div></li>
            <li><span class="roadmap-status planned" aria-label="Planned">&#9675;</span><div><strong>Full downvalley coverage</strong> - Brewster, Pateros, Okanogan, and Omak served as neighbors, not as mileage.</div></li>
            <li><span class="roadmap-status planned" aria-label="Planned">&#9675;</span><div><strong>Cumulative diversion goal: 100,000 lbs.</strong></div></li>
            <li><span class="roadmap-status planned" aria-label="Planned">&#9675;</span><div><strong>Annual community giving reaches $5,000+/year.</strong></div></li>
            <li><span class="roadmap-status planned" aria-label="Planned">&#9675;</span><div><strong>First refurbished-goods resale event</strong> - rescued items back into valley homes at honest prices.</div></li>
          </ul>
        </article>

        <article class="roadmap-year-card reveal">
          <div class="roadmap-year-heading">
            <span>2029</span>
            <h3>The Infrastructure Year</h3>
            <p>Build the engine that makes it permanent.</p>
          </div>
          <ul class="roadmap-list">
            <li><span class="roadmap-status planned" aria-label="Planned">&#9675;</span><div><strong>Open the Iron Path Recovery Yard</strong> - a dedicated sorting, refurbishing, and firewood-processing site in the valley.</div></li>
            <li><span class="roadmap-status planned" aria-label="Planned">&#9675;</span><div><strong>Diversion rate goal: 60% of everything we haul</strong> finds a second life instead of a landfill.</div></li>
            <li><span class="roadmap-status planned" aria-label="Planned">&#9675;</span><div><strong>3+ local jobs created and sustained.</strong></div></li>
            <li><span class="roadmap-status planned" aria-label="Planned">&#9675;</span><div><strong>Volunteer program expands to families</strong> - seasonal calendar, school partnerships, valley-wide cleanup events.</div></li>
            <li><span class="roadmap-status planned" aria-label="Planned">&#9675;</span><div><strong>Cumulative giving passes $15,000.</strong></div></li>
          </ul>
        </article>

        <article class="roadmap-year-card reveal">
          <div class="roadmap-year-heading">
            <span>2030</span>
            <h3>The Legacy Year</h3>
            <p>Five years in. A valley institution, built by the valley.</p>
          </div>
          <ul class="roadmap-list">
            <li><span class="roadmap-status planned" aria-label="Planned">&#9675;</span><div><strong>250,000 lbs diverted. $25,000 reinvested. 5+ local jobs.</strong></div></li>
            <li><span class="roadmap-status planned" aria-label="Planned">&#9675;</span><div><strong>First named community project funded</strong> - a school program, a park improvement, a trail - chosen by you, built with Iron Path dollars.</div></li>
            <li><span class="roadmap-status planned" aria-label="Planned">&#9675;</span><div><strong>The Iron Path Local Directory</strong> - a published guide to every trusted business in our referral network. If we cannot do the job, we know the neighbor who can.</div></li>
            <li><span class="roadmap-status planned" aria-label="Planned">&#9675;</span><div><strong>Five Valley Impact Reports published.</strong> Five years of receipts.</div></li>
          </ul>
        </article>
      </div>

      <div class="promise-accountability">
        <div>
          <span class="promise-numbers-label">How you hold us accountable</span>
          <ol>
            <li><strong>The Investment Tracker</strong> - every pledged dollar, published live at <a href="/investment-tracker/">ironpathservices.com/investment-tracker</a>.</li>
            <li><strong>The Annual Valley Impact Report</strong> - released each January, starting 2027.</li>
            <li><strong>This page</strong> - statuses update as goals are hit or missed. If we miss one, we will say so and tell you why. We would rather post an honest miss than a quiet excuse.</li>
          </ol>
        </div>
        <div class="promise-closing">
          <h3>A path forged in trust</h3>
          <p>
            Most companies write mission statements. We wrote a scoreboard. This valley gave three
            people a place to build something. This roadmap is how we pay it back - measured in
            pounds, dollars, jobs, and showing up.
          </p>
          <p><strong>Watch us. Better yet - walk it with us.</strong></p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="eyebrow">Living Services Tree</div>
      <h2>Every service is a <em>branch</em> of the same promise.</h2>
      <p class="lead">
        The tree is decorative; the cards contain the accessible service information. On mobile,
        the branches stack for easy reading.
      </p>
      <ServiceTree />
    </div>
  </section>

  <section class="section sand">
    <div class="container grid two" style="align-items: center;">
      <div>
        <div class="eyebrow">Where We Serve</div>
        <h2>13 communities <em>and counting.</em></h2>
        <p class="lead">Based in Winthrop, serving the Methow Valley and Okanogan County.</p>
        <ul class="pill-list">
          {serviceAreas.map((area) => <li>{area}</li>)}
        </ul>
        <div class="form-note">
          {travelFeeNote}
        </div>
      </div>
      <div class="image-card" style="--image-url: url('/assets/img-wrecked.jpg');" role="img" aria-label="Methow Valley service area image"></div>
    </div>
  </section>

  <section class="section">
    <div class="container grid three">
      <div class="card reveal">
        <h3>What to Expect</h3>
        <p>Fast response, written pricing, scheduled arrival windows, before-and-after photos, and respectful follow-up after the job.</p>
      </div>
      <div class="card reveal">
        <h3>What We Do Not Do</h3>
        <p>No hazardous materials, biohazard waste, asbestos, heavy construction debris, plumbing, electrical, or trade-licensed work.</p>
      </div>
      <div class="card reveal">
        <h3>The Green Initiative</h3>
        <p>We refurbish reusable items, reclaim safe firewood, and turn paper waste into recycled fire starter blocks.</p>
      </div>
    </div>
  </section>

  <section class="section dark">
    <div class="container">
      <div class="eyebrow">Common Questions</div>
      <h2>FAQ</h2>
      <div class="grid two" style="margin-top: 28px;">
        {faqs.slice(0, 6).map(([question, answer]) => (
          <div class="card reveal">
            <h3>{question}</h3>
            <p>{answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section sand">
    <div class="container">
      <div class="eyebrow">Reviews</div>
      <h2>What people <em>say.</em></h2>
      <div class={`review-grid${reviews.length === 1 ? ' is-single' : ''}`} style="margin-top: 28px;">
        {reviews.map((review) => (
          <ReviewCard review={review} featured={reviews.length === 1} />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="eyebrow">Get Started</div>
      <h2>Request a free <em>estimate.</em></h2>
      <p class="lead">
        Send the details once on the official Get A Quote form. Your request goes to the Iron Path
        team so we can review the scope and follow up with next steps.
      </p>
      <TallyEmbed formKey="getAQuote" />
    </div>
  </section>

  <section class="section sand compact">
    <div class="container">
      <div class="eyebrow">Official request forms</div>
      <h2>Choose the fastest <em>request path.</em></h2>
      <GoogleFormLinks
        columns="three"
        titles={[
          'Firewood Services',
          'Vending / ATM Placement Inquiry',
          'Secure Paper Shredding',
        ]}
      />
    </div>
  </section>
</BaseLayout>
