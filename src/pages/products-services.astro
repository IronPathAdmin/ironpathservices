---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ServiceDetail from '../components/ServiceDetail.astro';
import RecommendServiceForm from '../components/RecommendServiceForm.astro';
import { futureServices, googleForms, primaryServices, secondaryServices } from '../data/site';

const serviceForms = {
  cleaning: { provider: 'tally' as const, formKey: 'getAQuote' as const },
  'junk-removal': { provider: 'tally' as const, formKey: 'getAQuote' as const },
  'document-shredding': { provider: 'tally' as const, formKey: 'paperShredding' as const },
  firewood: { provider: 'google' as const, href: googleForms.firewoodOrder },
  'vending-atm': { provider: 'google' as const, href: googleForms.vendingAtm },
};
---

<BaseLayout title="Products & Services" description="In-depth Iron Path Services offerings for House Cleaning, Junk Removal, Secure Paper Shredding, Firewood Services, Transit (coming soon), plus Vending Machines & ATMs and future service ideas.">
  <PageHero eyebrow="Products & Services" title="Practical services, <em>community-minded</em> products." lead="The main five, secondary offerings, and space to recommend what the valley needs next." />

  <section class="section">
    <div class="container grid" style="gap: 34px;">
      <div>
        <div class="eyebrow">Main Services</div>
        <h2>The core <em>branches.</em></h2>
      </div>
      {primaryServices.map((service) => (
        <ServiceDetail service={service} form={serviceForms[service.slug as keyof typeof serviceForms]} />
      ))}
    </div>
  </section>

  <section class="section sand" id="secondary-services">
    <div class="container grid" style="gap: 34px;">
      <div>
        <div class="eyebrow">Secondary Services</div>
        <h2>Also available <em>when you need them.</em></h2>
        <p class="lead">
          These offerings stay on the menu. They are listed separately from the main service
          branches.
        </p>
      </div>
      {secondaryServices.map((service) => (
        <ServiceDetail service={service} form={serviceForms[service.slug as keyof typeof serviceForms]} />
      ))}
    </div>
  </section>

  <section class="section" id="future-services">
    <div class="container grid two" style="align-items: start; gap: 34px;">
      <div>
        <div class="eyebrow">Possible Future Services</div>
        <h2>What should we <em>offer next?</em></h2>
        <p class="lead">
          Iron Path grows with the valley. If you need something we do not offer yet, recommend
          it. We read every idea.
        </p>
        {futureServices.length > 0 && (
          <div class="future-services-list">
            {futureServices.map((service) => (
              <article class="card sand reveal">
                <p class="coming-soon-badge">Under consideration</p>
                <h3>{service.title}</h3>
                <p>{service.summary}</p>
              </article>
            ))}
          </div>
        )}
      </div>
      <RecommendServiceForm />
    </div>
  </section>
</BaseLayout>
