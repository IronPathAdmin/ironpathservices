---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PricingUpdateNotice from '../components/PricingUpdateNotice.astro';
import TallyPopupButton from '../components/TallyPopupButton.astro';
import { googleFormFinePrint, googleForms, services, tallyForms } from '../data/site';

const serviceForms = {
  cleaning: { provider: 'tally' as const, formKey: 'getAQuote' as const },
  'junk-removal': { provider: 'tally' as const, formKey: 'getAQuote' as const },
  'document-shredding': { provider: 'tally' as const, formKey: 'paperShredding' as const },
  firewood: { provider: 'google' as const, href: googleForms.firewoodOrder },
  'vending-atm': { provider: 'google' as const, href: googleForms.vendingAtm },
};
---

<BaseLayout title="Products & Services" description="In-depth Iron Path Services offerings for House Cleaning, Junk Removal, Secure Paper Shredding, Firewood Services, Vending Machines & ATMs.">
  <PageHero eyebrow="Products & Services" title="Practical services, <em>community-minded</em> products." lead="A deeper look at each active branch of Iron Path Services." />

  <section class="section compact">
    <div class="container">
      <PricingUpdateNotice />
    </div>
  </section>

  <section class="section">
    <div class="container grid" style="gap: 34px;">
      {services.map((service) => {
        const form = serviceForms[service.slug as keyof typeof serviceForms];
        return (
        <article class="card reveal" id={service.slug}>
          <div class="grid two" style="align-items: center;">
            <div>
              <h2>{service.title}</h2>
              <p class="lead">{service.description}</p>
              <ul>
                {service.bullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
              <div style="display: flex; gap: 12px; flex-wrap: wrap;">
                {form.provider === 'tally' ? (
                  <TallyPopupButton formKey={form.formKey} />
                ) : (
                  <a class="btn" href={form.href} target="_blank" rel="noreferrer">Open Google Form</a>
                )}
                <a class="btn secondary" href="/get-a-quote/">Estimate Page</a>
              </div>
              {form.provider === 'tally' ? (
                <p class="fine-print">{tallyForms[form.formKey].finePrint}</p>
              ) : (
                <p class="fine-print">{googleFormFinePrint}</p>
              )}
            </div>
            <div>
              <div class="image-card" style={`--image-url: url('${service.image}');`} role="img" aria-label={`${service.title} image`}></div>
              {'galleryReady' in service && service.galleryReady && 'gallery' in service && Array.isArray(service.gallery) && (
                <div class="service-gallery" aria-label={`${service.title} image gallery`}>
                  {service.gallery.map((image) => (
                    <figure class="service-gallery-item">
                      <div class="service-gallery-image" style={`--image-url: url('${image.src}');`} role="img" aria-label={image.alt}></div>
                      <figcaption>{image.alt}</figcaption>
                    </figure>
                  ))}
                </div>
              )}
            </div>
          </div>
        </article>
        );
      })}
    </div>
  </section>

</BaseLayout>
