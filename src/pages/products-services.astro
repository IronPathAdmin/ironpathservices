---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PricingUpdateNotice from '../components/PricingUpdateNotice.astro';
import ServiceDetail from '../components/ServiceDetail.astro';
import { googleForms, primaryServices, secondaryServices } from '../data/site';

const serviceForms = {
  cleaning: { provider: 'tally' as const, formKey: 'getAQuote' as const },
  'junk-removal': { provider: 'tally' as const, formKey: 'getAQuote' as const },
  'document-shredding': { provider: 'tally' as const, formKey: 'paperShredding' as const },
  firewood: { provider: 'google' as const, href: googleForms.firewoodOrder },
  'vending-atm': { provider: 'google' as const, href: googleForms.vendingAtm },
};
---

<BaseLayout title="Products & Services" description="In-depth Iron Path Services offerings for House Cleaning, Junk Removal, Secure Paper Shredding, Firewood Services, Transit (coming soon), plus Vending Machines & ATMs.">
  <PageHero eyebrow="Products & Services" title="Practical services, <em>community-minded</em> products." lead="A deeper look at each active branch of Iron Path Services, plus secondary offerings." />

  <section class="section compact">
    <div class="container">
      <PricingUpdateNotice />
    </div>
  </section>

  <section class="section">
    <div class="container grid" style="gap: 34px;">
      {primaryServices.map((service) => (
        <ServiceDetail service={service} form={serviceForms[service.slug as keyof typeof serviceForms]} />
      ))}
    </div>
  </section>

  <section class="section sand" id="secondary-services">
    <div class="container grid" style="gap: 34px;">
      <div>
        <div class="eyebrow">Secondary Services</div>
        <h2>Also available <em>when you need them.</em></h2>
        <p class="lead">
          These offerings stay on the menu. They are listed separately from the main service
          branches.
        </p>
      </div>
      {secondaryServices.map((service) => (
        <ServiceDetail service={service} form={serviceForms[service.slug as keyof typeof serviceForms]} />
      ))}
    </div>
  </section>
</BaseLayout>
