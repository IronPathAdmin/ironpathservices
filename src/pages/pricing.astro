---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PricingTable from '../components/PricingTable.astro';
import TallyPopupButton from '../components/TallyPopupButton.astro';
import {
  commercialDiscounts,
  commercialPriceGroups,
  communityGiveBack,
  communityGivingDiscounts,
  communityPledge,
  discountCapNote,
  discounts,
  fees,
  generalPriceGroups,
  googleFormFinePrint,
  invoiceOrderNote,
  paymentPolicy,
  paymentProcessingNote,
  pricingDownloads,
  promotions,
  salesTax,
  salesTaxNote,
} from '../data/site';
---

<BaseLayout title="Pricing" description="Official Iron Path Services general and commercial pricing, fees, discounts, taxes, and printable rate sheets.">
  <PageHero
    eyebrow="Official Pricing"
    title="No surprises. <em>Ever.</em>"
    lead="The public rates match the official General and Commercial pricing guides. Every surcharge, discount, and tax that could appear on an invoice is listed before work begins."
  />

  <section class="section compact">
    <div class="container">
      <div class="pricing-jump">
        <a class="btn" href="#general-pricing">General Pricing</a>
        <a class="btn secondary" href="#commercial-pricing">Commercial Pricing</a>
        <a class="btn secondary" href="#fees">Fees & Taxes</a>
        <a class="btn secondary" href="#pricing-downloads">Download PDFs</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid two">
        <div class="card sand">
          <h3>{communityPledge.title}</h3>
          <p>{communityPledge.summary}</p>
        </div>
        <div class="card sand">
          <h3>Payment Policy</h3>
          <p>{paymentPolicy}</p>
          <p class="form-note">{invoiceOrderNote}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section sand compact" id="pricing-downloads">
    <div class="container">
      <div class="eyebrow">Printable PDFs</div>
      <h2>Download the official <em>rate sheets.</em></h2>
      <div class="grid two" style="margin-top: 28px;">
        {pricingDownloads.map((download) => (
          <article class="card">
            <h3>{download.title}</h3>
            <p>{download.description}</p>
            <a class="btn" href={download.href} download>Download PDF</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  {promotions.length > 0 && (
    <section class="section compact">
      <div class="container">
        <div class="eyebrow">Promotions</div>
        <h2>Current <em>promotions.</em></h2>
        <p class="lead">The Iron Path Giveaway is still open. The $150 FIRST30 launch special has ended.</p>
        <div class="promotion-grid" style="margin-top: 28px;">
          {promotions.map((promotion) => (
            <article class="card reveal promotion-card">
              <div>
                <h3>{promotion.title}</h3>
                {promotion.status && <p class="promotion-status">{promotion.status}</p>}
                <p>{promotion.details}</p>
              </div>

              {promotion.dates && (
                <div class="promotion-dates" aria-label={`${promotion.title} important dates`}>
                  {promotion.dates.map((date) => (
                    <div>
                      <span>{date.label}</span>
                      <strong>{date.value}</strong>
                    </div>
                  ))}
                </div>
              )}

              {promotion.prizeOptions && (
                <div>
                  <h4>{promotion.optionsHeading ?? 'Prize choices'}</h4>
                  <ul>
                    {promotion.prizeOptions.map((option) => <li>{option}</li>)}
                  </ul>
                </div>
              )}

              {promotion.entrySteps && (
                <div>
                  <h4>How to enter</h4>
                  {promotion.socialEntries && (
                    <div class="promotion-socials">
                      {promotion.socialEntries.map((social) => (
                        <a
                          class={`promotion-social ${social.platform}`}
                          href={social.href}
                          target="_blank"
                          rel="noreferrer"
                        >
                          <span>{social.label}</span>
                          <strong>{social.handle}</strong>
                          <em>{social.entries}</em>
                        </a>
                      ))}
                    </div>
                  )}
                  <ul>
                    {promotion.entrySteps.map((step) => <li>{step}</li>)}
                  </ul>
                </div>
              )}

              {promotion.bonusEntries && (
                <div>
                  <h4>Bonus entries</h4>
                  <ul>
                    {promotion.bonusEntries.map((entry) => <li>{entry}</li>)}
                  </ul>
                </div>
              )}

              {promotion.nominationDetails && (
                <div class="promotion-callout">
                  <h4>Nominate someone deserving</h4>
                  <p>{promotion.nominationDetails}</p>
                </div>
              )}

              {promotion.cta && (
                <a class="btn" href={promotion.cta.href} target="_blank" rel="noreferrer">
                  {promotion.cta.label}
                </a>
              )}

              <div>
                <p class="fine-print">{promotion.finePrint}</p>
                <p class="fine-print">{googleFormFinePrint}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section compact" id="general-pricing">
    <div class="container">
      <div class="eyebrow">General Pricing Guide</div>
      <h2>Residential and <em>local rates.</em></h2>
      <p class="lead">These tables match the official General Pricing Guide. Written estimates are still confirmed before work begins.</p>
    </div>
  </section>

  {generalPriceGroups.map((group) => (
    <section class="section compact" id={group.id}>
      <div class="container">
        <div class="eyebrow">{group.title}</div>
        <h2>{group.title} <em>{group.em}</em></h2>
        <p class="lead">{group.note}</p>
        <div class="price-table-stack">
          {group.tables.map((table) => (
            <PricingTable title={table.title} columns={table.columns} rows={table.rows} />
          ))}
        </div>
        {group.tally === 'paperShredding' && (
          <div style="margin-top: 20px; display: flex; gap: 12px; flex-wrap: wrap; align-items: center;">
            <TallyPopupButton />
            <p class="fine-print" style="margin: 0;">Opens the official Secure Paper Shredding Intake form. No Google login required.</p>
          </div>
        )}
      </div>
    </section>
  ))}

  <section class="section sand compact" id="commercial-pricing">
    <div class="container">
      <div class="eyebrow">Commercial Pricing</div>
      <h2>Business and <em>property rates.</em></h2>
      <p class="lead">For business, office, and commercial-property clients. Residential rates and terms are in the General Pricing Guide.</p>
    </div>
  </section>

  {commercialPriceGroups.map((group) => (
    <section class="section compact" id={group.id}>
      <div class="container">
        <div class="eyebrow">{group.title}</div>
        <h2>{group.title} <em>{group.em}</em></h2>
        <p class="lead">{group.note}</p>
        <div class="price-table-stack">
          {group.tables.map((table) => (
            <PricingTable title={table.title} columns={table.columns} rows={table.rows} />
          ))}
        </div>
        {group.tally === 'paperShredding' && (
          <div style="margin-top: 20px; display: flex; gap: 12px; flex-wrap: wrap; align-items: center;">
            <TallyPopupButton />
            <p class="fine-print" style="margin: 0;">Opens the official Secure Paper Shredding Intake form. No Google login required.</p>
          </div>
        )}
      </div>
    </section>
  ))}

  <section class="section sand" id="give-back">
    <div class="container">
      <div class="eyebrow">Community Give-Back</div>
      <h2>Add a gift to the <em>valley fund.</em></h2>
      <p class="lead">{communityGiveBack.note}</p>
      <PricingTable columns={['Tier', 'Amount']} rows={communityGiveBack.rows} />
    </div>
  </section>

  <section class="section" id="fees">
    <div class="container grid two">
      <div>
        <div class="eyebrow">Fees & Taxes</div>
        <h2>Always disclosed <em>upfront.</em></h2>
        <PricingTable columns={['Fee', 'Amount']} rows={fees} />
        <p class="form-note">{paymentProcessingNote}</p>
      </div>
      <div>
        <div class="eyebrow">Discounts</div>
        <h2>Programs that <em>give back.</em></h2>
        <p class="lead">{discountCapNote}</p>
        <PricingTable title="General discounts" columns={['Discount', 'Amount']} rows={discounts} />
        <PricingTable title="Community giving discount" columns={['Donation Level', 'Discount']} rows={communityGivingDiscounts} />
        <p class="form-note">100% of the donation goes to the Methow Valley Fund.</p>
        <PricingTable title="Commercial discounts" columns={['Discount', 'Amount']} rows={commercialDiscounts} />
      </div>
    </div>
  </section>

  <section class="section sand compact">
    <div class="container">
      <div class="eyebrow">Sales Tax</div>
      <h2>Combined rate by <em>location.</em></h2>
      <p class="lead">{salesTaxNote}</p>
      <PricingTable columns={['Location', 'Combined Rate']} rows={salesTax} />
    </div>
  </section>

  <section class="section green compact">
    <div class="container" style="display: flex; justify-content: space-between; gap: 20px; align-items: center; flex-wrap: wrap;">
      <div>
        <div class="eyebrow">Need a quote?</div>
        <h2>Rates are public. <em>Your job is unique.</em></h2>
      </div>
      <a class="btn" href="/get-a-quote/">Request a Quote</a>
    </div>
  </section>
</BaseLayout>
