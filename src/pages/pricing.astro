---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { discounts, fees, googleFormFinePrint, pricingTables, promotions } from '../data/site';

const currentPromotions = [...promotions].sort((a, b) => {
  if (a.promoCode === 'FIRST30') return -1;
  if (b.promoCode === 'FIRST30') return 1;
  return 0;
});
---

<BaseLayout title="Pricing" description="Transparent pricing, fees, add-ons, discounts, payment terms, and printable pricing PDF for Iron Path Services.">
  <PageHero eyebrow="Transparent Pricing" title="No surprises. <em>Ever.</em>" lead="Effective June 1, 2026. Every rate, surcharge, and tax that could appear on an invoice is listed before work begins." />

  <section class="section">
    <div class="container">
      <div class="grid two">
        <div class="card sand">
          <h3>Community Donation Pledge</h3>
          <p>A meaningful percentage of profits is pledged toward Methow Valley businesses, schools, parks, and community needs.</p>
        </div>
        <div class="card sand">
          <h3>Payment Policy</h3>
          <p>Accepted methods include cash, check, and on-site card payments. Invoice timing is agreed before work begins, and quoted prices are final with no post-job additions.</p>
        </div>
      </div>
    </div>
  </section>

  {currentPromotions.length > 0 && (
    <section class="section sand compact">
      <div class="container">
        <div class="eyebrow">Promotions</div>
        <h2>Current <em>promotions.</em></h2>
        <p class="lead">
          Seasonal offers and service specials are posted here with full terms and fine print.
        </p>
        <div class="promotion-grid" style="margin-top: 28px;">
          {currentPromotions.map((promotion) => (
            <article class={`card reveal promotion-card${promotion.promoCode === 'FIRST30' ? ' is-live' : ''}`}>
              <div>
                <h3>{promotion.title}</h3>
                {promotion.status && <p class="promotion-status">{promotion.status}</p>}
                <p>{promotion.details}</p>
              </div>

              {promotion.promoCode && (
                <div class="promotion-code" aria-label={`${promotion.title} promo code`}>
                  <span>Promo code</span>
                  <strong>{promotion.promoCode}</strong>
                </div>
              )}

              {promotion.dates && (
                <div class="promotion-dates" aria-label={`${promotion.title} important dates`}>
                  {promotion.dates.map((date) => (
                    <div>
                      <span>{date.label}</span>
                      <strong>{date.value}</strong>
                    </div>
                  ))}
                </div>
              )}

              {promotion.prizeOptions && (
                <div>
                  <h4>{promotion.optionsHeading ?? 'Prize choices'}</h4>
                  <ul>
                    {promotion.prizeOptions.map((option) => <li>{option}</li>)}
                  </ul>
                </div>
              )}

              {promotion.offerDetails && (
                <div>
                  <h4>Offer details</h4>
                  <ul>
                    {promotion.offerDetails.map((detail) => <li>{detail}</li>)}
                  </ul>
                </div>
              )}

              {promotion.entrySteps && (
                <div>
                  <h4>How to enter</h4>
                  {promotion.socialEntries && (
                    <div class="promotion-socials">
                      {promotion.socialEntries.map((social) => (
                        <a
                          class={`promotion-social ${social.platform}`}
                          href={social.href}
                          target="_blank"
                          rel="noreferrer"
                        >
                          <span>{social.label}</span>
                          <strong>{social.handle}</strong>
                          <em>{social.entries}</em>
                        </a>
                      ))}
                    </div>
                  )}
                  <ul>
                    {promotion.entrySteps.map((step) => <li>{step}</li>)}
                  </ul>
                </div>
              )}

              {promotion.bonusEntries && (
                <div>
                  <h4>Bonus entries</h4>
                  <ul>
                    {promotion.bonusEntries.map((entry) => <li>{entry}</li>)}
                  </ul>
                </div>
              )}

              {promotion.nominationDetails && (
                <div class="promotion-callout">
                  <h4>Nominate someone deserving</h4>
                  <p>{promotion.nominationDetails}</p>
                </div>
              )}

              {promotion.cta && (
                <a class="btn" href={promotion.cta.href} target="_blank" rel="noreferrer">
                  {promotion.cta.label}
                </a>
              )}

              <div>
                <p class="fine-print">{promotion.finePrint}</p>
                <p class="fine-print">{googleFormFinePrint}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {pricingTables.map((table) => (
    <section class="section compact">
      <div class="container">
        <div class="eyebrow">{table.title}</div>
        <h2>{table.title} <em>pricing.</em></h2>
        <p class="lead">{table.note}</p>
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th>Item</th><th>Rate</th><th>Notes</th></tr>
            </thead>
            <tbody>
              {table.rows.map((row) => (
                <tr>{row.map((cell) => <td>{cell}</td>)}</tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  ))}

  <section class="section sand">
    <div class="container grid two">
      <div>
        <div class="eyebrow">Fees & Add-ons</div>
        <h2>Always disclosed <em>upfront.</em></h2>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Fee</th><th>Amount</th></tr></thead>
            <tbody>{fees.map((row) => <tr><td>{row[0]}</td><td>{row[1]}</td></tr>)}</tbody>
          </table>
        </div>
      </div>
      <div>
        <div class="eyebrow">Discounts</div>
        <h2>Programs that <em>give back.</em></h2>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Discount</th><th>Eligibility</th></tr></thead>
            <tbody>{discounts.map((row) => <tr><td>{row[0]}</td><td>{row[1]}</td></tr>)}</tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <section class="section green compact">
    <div class="container" style="display: flex; justify-content: space-between; gap: 20px; align-items: center; flex-wrap: wrap;">
      <div>
        <div class="eyebrow">Printable PDF</div>
        <h2>Download the current pricing sheet.</h2>
      </div>
      <a class="btn" href="/downloads/ironpath-customer-pricing.pdf" download>Download Pricing PDF</a>
    </div>
  </section>
</BaseLayout>
