---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PricingTable from '../components/PricingTable.astro';
import PriceGroupFold from '../components/PriceGroupFold.astro';
import {
  commercialDiscounts,
  commercialPriceGroups,
  communityGiveBack,
  communityGivingDiscounts,
  communityPledge,
  discountCapNote,
  discounts,
  fees,
  generalPriceGroups,
  googleFormFinePrint,
  invoiceOrderSteps,
  paymentMethodGroups,
  paymentProcessingNote,
  pricingDownloads,
  promotions,
  salesTax,
  salesTaxNote,
} from '../data/site';
---

<BaseLayout title="Pricing" description="Official Iron Path Services general and commercial pricing, fees, discounts, taxes, and printable rate sheets.">
  <PageHero
    eyebrow="Official Pricing"
    title="No surprises. <em>Ever.</em>"
    lead="The public rates match the official General and Commercial pricing guides. Every surcharge, discount, and tax that could appear on an invoice is listed before work begins."
  />

  <section class="section compact">
    <div class="container">
      <div class="eyebrow">Rate sheets</div>
      <h2>Open the rates you <em>need.</em></h2>
      <p class="lead">Buttons open the matching tables here instead of sending you down the page.</p>

      <div class="pricing-accordion" data-pricing-accordion>
        <details class="pricing-fold" id="general-pricing" name="pricing-rates">
          <summary>General Pricing</summary>
          <div class="pricing-fold-panel">
            <p class="lead">Residential and local rates from the official General Pricing Guide. Written estimates are still confirmed before work begins.</p>
            {generalPriceGroups.map((group) => (
              <PriceGroupFold group={group} />
            ))}
          </div>
        </details>

        <details class="pricing-fold" id="commercial-pricing" name="pricing-rates">
          <summary>Commercial Pricing</summary>
          <div class="pricing-fold-panel">
            <p class="lead">Business, office, and commercial-property rates. Residential rates and terms are in General Pricing.</p>
            {commercialPriceGroups.map((group) => (
              <PriceGroupFold group={group} />
            ))}
          </div>
        </details>

        <details class="pricing-fold" id="fees" name="pricing-rates">
          <summary>Fees &amp; Taxes</summary>
          <div class="pricing-fold-panel">
            <p class="lead">Always disclosed upfront. Discounts can stack, and the combined discount is capped at 30%.</p>
            <div class="pricing-fee-grid">
              <div>
                <h3>Fees</h3>
                <PricingTable columns={['Fee', 'Amount']} rows={fees} />
                <p class="form-note">{paymentProcessingNote}</p>
              </div>
              <div>
                <h3>Discounts</h3>
                <p class="form-note">{discountCapNote}</p>
                <PricingTable title="General discounts" columns={['Discount', 'Amount']} rows={discounts} />
                <PricingTable title="Community giving discount" columns={['Donation Level', 'Discount']} rows={communityGivingDiscounts} />
                <p class="form-note">100% of the donation goes to the Methow Valley Fund.</p>
                <PricingTable title="Commercial discounts" columns={['Discount', 'Amount']} rows={commercialDiscounts} />
              </div>
            </div>
            <div class="pricing-fee-extra">
              <div>
                <h3>Sales tax</h3>
                <p class="form-note">{salesTaxNote}</p>
                <PricingTable columns={['Location', 'Combined Rate']} rows={salesTax} />
              </div>
              <div>
                <h3>Community give-back</h3>
                <p class="form-note">{communityGiveBack.note}</p>
                <PricingTable columns={['Tier', 'Amount']} rows={communityGiveBack.rows} />
              </div>
            </div>
          </div>
        </details>
      </div>
    </div>
  </section>

  <section class="section sand compact" id="policies">
    <div class="container">
      <div class="eyebrow">Policies</div>
      <h2>How billing and giving <em>work.</em></h2>
      <div class="policy-stack">
        <article class="policy-block">
          <h3>Payment Policy</h3>
          <ul class="policy-points">
            {paymentMethodGroups.map((group) => (
              <li>
                <strong>{group.label}</strong>
                <span>{group.methods}</span>
              </li>
            ))}
            <li>
              <strong>Timing</strong>
              <span>Invoice timing is agreed before work begins.</span>
            </li>
          </ul>
          <p class="policy-label">Invoice order</p>
          <ol class="invoice-order">
            {invoiceOrderSteps.map((step) => (
              <li>{step}</li>
            ))}
          </ol>
        </article>

        <article class="policy-block">
          <h3>{communityPledge.title}</h3>
          <ul class="policy-points">
            {communityPledge.points.map((point) => (
              <li>
                <strong>{point.label}</strong>
                <span>{point.text}</span>
              </li>
            ))}
          </ul>
        </article>
      </div>
    </div>
  </section>

  {promotions.length > 0 && (
    <section class="section compact" id="current-promotions">
      <div class="container">
        <div class="eyebrow">Promotions</div>
        <h2>Current <em>promotions.</em></h2>
        <p class="lead">The Iron Path Giveaway is still open. The $150 FIRST30 launch special has ended.</p>
        <div class="promotion-grid" style="margin-top: 28px;">
          {promotions.map((promotion) => (
            <article class="card reveal promotion-card">
              <div>
                <h3>{promotion.title}</h3>
                {promotion.status && <p class="promotion-status">{promotion.status}</p>}
                <p>{promotion.details}</p>
              </div>

              {promotion.dates && (
                <div class="promotion-dates" aria-label={`${promotion.title} important dates`}>
                  {promotion.dates.map((date) => (
                    <div>
                      <span>{date.label}</span>
                      <strong>{date.value}</strong>
                    </div>
                  ))}
                </div>
              )}

              {promotion.prizeOptions && (
                <div>
                  <h4>{promotion.optionsHeading ?? 'Prize choices'}</h4>
                  <ul>
                    {promotion.prizeOptions.map((option) => <li>{option}</li>)}
                  </ul>
                </div>
              )}

              {promotion.entrySteps && (
                <div>
                  <h4>How to enter</h4>
                  {promotion.socialEntries && (
                    <div class="promotion-socials">
                      {promotion.socialEntries.map((social) => (
                        <a
                          class={`promotion-social ${social.platform}`}
                          href={social.href}
                          target="_blank"
                          rel="noreferrer"
                        >
                          <span>{social.label}</span>
                          <strong>{social.handle}</strong>
                          <em>{social.entries}</em>
                        </a>
                      ))}
                    </div>
                  )}
                  <ul>
                    {promotion.entrySteps.map((step) => <li>{step}</li>)}
                  </ul>
                </div>
              )}

              {promotion.bonusEntries && (
                <div>
                  <h4>Bonus entries</h4>
                  <ul>
                    {promotion.bonusEntries.map((entry) => <li>{entry}</li>)}
                  </ul>
                </div>
              )}

              {promotion.nominationDetails && (
                <div class="promotion-callout">
                  <h4>Nominate someone deserving</h4>
                  <p>{promotion.nominationDetails}</p>
                </div>
              )}

              {promotion.cta && (
                <a class="btn" href={promotion.cta.href} target="_blank" rel="noreferrer">
                  {promotion.cta.label}
                </a>
              )}

              <div>
                <p class="fine-print">{promotion.finePrint}</p>
                <p class="fine-print">{googleFormFinePrint}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section green compact">
    <div class="container" style="display: flex; justify-content: space-between; gap: 20px; align-items: center; flex-wrap: wrap;">
      <div>
        <div class="eyebrow">Need a quote?</div>
        <h2>Rates are public. <em>Your job is unique.</em></h2>
      </div>
      <a class="btn" href="/get-a-quote/">Request a Quote</a>
    </div>
  </section>

  <section class="section compact" id="pricing-downloads">
    <div class="container">
      <div class="eyebrow">Printable PDFs</div>
      <h2>Download the official <em>rate sheets.</em></h2>
      <div class="grid two pricing-download-grid">
        {pricingDownloads.map((download) => (
          <article class="card">
            <h3>{download.title}</h3>
            <p>{download.description}</p>
            <a class="btn" href={download.href} download>Download PDF</a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
