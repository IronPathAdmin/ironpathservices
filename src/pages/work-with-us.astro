---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import TallyEmbed from '../components/TallyEmbed.astro';
import TallyPopupButton from '../components/TallyPopupButton.astro';
import { tallyForms } from '../data/site';
---

<BaseLayout title="Work With Us" description="B2B opportunities with Iron Path Services, vending and ATM placement, referral partnerships, and website partner options.">
  <PageHero eyebrow="Work With Us" title="B2B opportunities <em>with a local operator.</em>" lead="Partner with Iron Path for vending, ATMs, recurring cleaning, commercial cleanouts, referral relationships, and website placement." />

  <section class="section">
    <div class="container grid three">
      {[
        ['Vending Machines & ATM Hosting', 'Add a machine at no upfront cost and receive 30% of net sales.'],
        ['Commercial Services', 'House Cleaning, Junk Removal, Moving Services, Secure Paper Shredding, and property support for local businesses. Commercial rates are on the pricing page.'],
        ['Put Us On Your Website', 'Partner badges, referral language, and preferred vendor listings can be provided.'],
      ].map(([title, text]) => (
        <article class="card sand reveal">
          <h3>{title}</h3>
          <p>{text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section sand">
    <div class="container grid two" style="align-items: start;">
      <div>
        <div class="eyebrow">Partnership Request</div>
        <h2>Tell us what you want <em>to build.</em></h2>
        <p class="lead">Share the partnership you have in mind. Your request goes to the leads inbox so the team can review fit and next steps.</p>
      </div>
      <ContactForm type="general" title="B2B Inquiry" />
    </div>
  </section>

  <section class="section compact" id="vending-atm">
    <div class="container grid two" style="align-items: start;">
      <div>
        <div class="eyebrow">Vending Machines &amp; ATMs</div>
        <h2>Host a machine at <em>no upfront cost.</em></h2>
        <p class="lead">
          Iron Path places and maintains ATMs and vending machines at local businesses. Fill out
          the placement inquiry and we will follow up to talk through space, power, and foot
          traffic.
        </p>
        <div class="hero-actions" style="margin-top: 24px;">
          <TallyPopupButton formKey="vendingAtm" class="btn" />
        </div>
        <p class="fine-print">{tallyForms.vendingAtm.finePrint}</p>
      </div>
      <TallyEmbed formKey="vendingAtm" />
    </div>
  </section>

  <section class="section compact" id="referral-partner">
    <div class="container grid two" style="align-items: start;">
      <div>
        <div class="eyebrow">Referral Partners</div>
        <h2>Join the local referral <em>ecosystem.</em></h2>
        <p class="lead">
          Own or run a local business that regularly connects with people who need property,
          cleanup, or estate support? Apply and we will follow up to talk through how referrals
          work.
        </p>
        <div class="hero-actions" style="margin-top: 24px;">
          <TallyPopupButton formKey="referralPartner" class="btn" />
        </div>
        <p class="fine-print">{tallyForms.referralPartner.finePrint}</p>
      </div>
      <TallyEmbed formKey="referralPartner" />
    </div>
  </section>
</BaseLayout>
