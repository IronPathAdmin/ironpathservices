---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { entrepreneurJourney } from '../../data/site';
---

<BaseLayout title={entrepreneurJourney.title} description={entrepreneurJourney.teaser}>
  <PageHero eyebrow="Stories" title={entrepreneurJourney.heroTitle} lead={entrepreneurJourney.lead} />

  <section class="section">
    <div class="container story-journey">
      <aside class="story-journey-aside">
        <img
          class="about-photo about-portrait-photo"
          src={entrepreneurJourney.portrait}
          alt={entrepreneurJourney.portraitAlt}
          width="683"
          height="1014"
        />
        <div class="card sand">
          <h3>{entrepreneurJourney.author}</h3>
          <p>{entrepreneurJourney.role}</p>
          <p class="story-journey-date">{entrepreneurJourney.dateLabel}</p>
        </div>
      </aside>
      <div class="story-journey-feed">
        <p class="story-journey-note"><strong>Note:</strong> {entrepreneurJourney.note}</p>
        {entrepreneurJourney.posts.length ? (
          <div class="story-journey-posts">
            {entrepreneurJourney.posts.map((post) => (
              <article class="card sand story-journey-article">
                <div class="eyebrow">{post.dateLabel}</div>
                <h2>{post.title}</h2>
                {post.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              </article>
            ))}
          </div>
        ) : (
          <article class="card sand story-journey-article">
            <p>{entrepreneurJourney.emptyState}</p>
          </article>
        )}
        <p>
          <a class="service-card-link" href="/stories/">Back to Stories -></a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
