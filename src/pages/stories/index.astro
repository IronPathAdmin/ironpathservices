---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { entrepreneurJourney, storyCards } from '../../data/site';
---

<BaseLayout title="Stories" description="Iron Path Services community blog for job stories, community moments, and inspirational stories.">
  <PageHero eyebrow="Stories" title="The Iron Path <em>community blog.</em>" lead="Stories from the field, community moments, photos, and reflections from the path we are building in the Methow Valley." />

  <section class="section">
    <div class="container grid three">
      {storyCards.map((story) => (
        <article class="card sand reveal">
          {story.image ? (
            <div class="image-card" style={`--image-url: url('${story.image}'); margin-bottom: 18px;`} role="img" aria-label={story.imageAlt}></div>
          ) : (
            <div class="placeholder-photo" style="margin-bottom: 18px;">Field photo coming soon</div>
          )}
          <h3>{story.title}</h3>
          <p>{story.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section sand" aria-labelledby="entrepreneur-journey-heading">
    <div class="container">
      <div class="story-inner-blog-intro">
        <div class="eyebrow">{entrepreneurJourney.seriesEyebrow}</div>
        <h2 id="entrepreneur-journey-heading" set:html={entrepreneurJourney.heroTitle} />
        <p class="lead">{entrepreneurJourney.seriesLead}</p>
      </div>
      <a class="story-feature card reveal" href={entrepreneurJourney.href}>
        <div class="story-feature-image image-card" style={`--image-url: url('${entrepreneurJourney.image}');`} role="img" aria-label={entrepreneurJourney.imageAlt}></div>
        <div class="story-feature-copy">
          <div class="eyebrow">{entrepreneurJourney.eyebrow}</div>
          <h3>{entrepreneurJourney.title}</h3>
          <p>{entrepreneurJourney.teaser}</p>
          <p class="story-journey-note"><strong>Note:</strong> {entrepreneurJourney.note}</p>
          <span class="service-card-link">Open this series -></span>
        </div>
      </a>
    </div>
  </section>
</BaseLayout>
