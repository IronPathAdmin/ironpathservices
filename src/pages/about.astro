---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { founderLetter, initiatives } from '../data/site';

const team = [
  {
    name: 'Benji',
    role: 'Founder & Strategy Architect',
    image: '/assets/photos/team/benji-founder.jpg',
    alt: 'Benji, Founder and Strategy Architect of Iron Path Services, standing by the Methow River',
    width: 683,
    height: 1014,
  },
  {
    name: 'Adrian',
    role: 'Operations Architect',
    image: '/assets/photos/team/adrian-operations.jpg',
    alt: 'Adrian, Operations Architect of Iron Path Services',
    width: 788,
    height: 1400,
  },
];
---

<BaseLayout title="About" description="A letter from Benji and the story of Iron Path Services in the Methow Valley.">
  <PageHero eyebrow="Who We Are" title="A letter from <em>Benji.</em>" lead="Iron Path Services was founded in March 2026 in the Methow Valley by Benji and Adrian, with Eloise the truck as the star of the show." />

  <section class="section">
    <div class="container grid two" style="align-items: start;">
      <div class="about-team">
        <div class="grid two">
          {team.map(({ name, role, image, alt, width, height }) => (
            <article class="about-team-slot">
              <img class="about-photo about-portrait-photo" src={image} alt={alt} width={width} height={height} />
              <div class="card sand">
                <h3>{name}</h3>
                <p>{role}</p>
              </div>
            </article>
          ))}
        </div>
        <article class="about-team-slot about-eloise-slot">
          <img
            class="about-photo about-eloise-photo"
            src="/assets/photos/team/eloise-truck.jpg"
            alt="Eloise, Iron Path's red work truck and the star of the show"
            width="1800"
            height="1350"
          />
          <div class="card sand">
            <h3>Eloise</h3>
            <p>Our truck and the star of the show.</p>
          </div>
        </article>
      </div>
      <article class="card sand">
        {founderLetter.map((paragraph) => <p>{paragraph}</p>)}
        <p><strong>- Benji</strong><br />Founder & Strategy Architect, Iron Path Services</p>
      </article>
    </div>
  </section>

  <section class="section dark">
    <div class="container">
      <div class="eyebrow">Five Commitments</div>
      <h2>Built on the <em>valley.</em></h2>
      <div class="grid three" style="margin-top: 28px;">
        {initiatives.slice(0, 5).map((item) => (
          <div class="card reveal">
            <h3>{item.title}</h3>
            <p>{item.summary}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
