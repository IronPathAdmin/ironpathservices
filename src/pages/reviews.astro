---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ReviewCard from '../components/ReviewCard.astro';
import TallyEmbed from '../components/TallyEmbed.astro';
import TallyPopupButton from '../components/TallyPopupButton.astro';
import { externalLinks, reviews, tallyForms } from '../data/site';

const featuredReview = reviews[0];
---

<BaseLayout title="Reviews" description="Iron Path Services customer reviews, review submission, Google reviews link, star ratings, and review of the week.">
  <PageHero eyebrow="Reviews" title="A growing book of <em>trust.</em>" lead="Customer feedback is reviewed before publishing so the page stays accurate, authentic, and useful." />

  <section class="section">
    <div class="container">
      {featuredReview ? (
        <>
          <div class="eyebrow">Latest Review</div>
          <ReviewCard review={featuredReview} featured />
          {reviews.length > 1 && (
            <div class="review-grid" style="margin-top: 28px;">
              {reviews.slice(1).map((review) => (
                <ReviewCard review={review} />
              ))}
            </div>
          )}
        </>
      ) : (
        <div class="card sand">
          <h2>Reviews are on the way.</h2>
          <p>Be the first to share your Iron Path experience. Submitted reviews are published after manual approval.</p>
        </div>
      )}
    </div>
  </section>

  <section class="section sand" id="submit-review">
    <div class="container grid two" style="align-items: start;">
      <div>
        <div class="eyebrow">Submit a Review</div>
        <h2>Manual approval, <em>then publish.</em></h2>
        <p class="lead">
          Fill out the official Customer Review Submission and we will review it before it appears
          on the website. You can also leave a public Google review.
        </p>
        <div class="hero-actions" style="margin-top: 24px;">
          <TallyPopupButton formKey="customerReview" class="btn" />
          <a class="btn secondary" href={externalLinks.googleReview} target="_blank" rel="noreferrer">Leave a Google Review</a>
        </div>
        <p class="fine-print">{tallyForms.customerReview.finePrint}</p>
      </div>
      <TallyEmbed formKey="customerReview" />
    </div>
  </section>
</BaseLayout>
