---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import ReviewCard from '../components/ReviewCard.astro';
import { externalLinks, googleFormFinePrint, googleForms, reviews } from '../data/site';

const featuredReview = reviews[0];
---

<BaseLayout title="Reviews" description="Iron Path Services customer reviews, review submission, Google reviews link, star ratings, and review of the week.">
  <PageHero eyebrow="Reviews" title="A growing book of <em>trust.</em>" lead="Customer feedback is reviewed before publishing so the page stays accurate, authentic, and useful." />

  <section class="section">
    <div class="container">
      {featuredReview ? (
        <>
          <div class="eyebrow">Latest Review</div>
          <ReviewCard review={featuredReview} featured />
          {reviews.length > 1 && (
            <div class="review-grid" style="margin-top: 28px;">
              {reviews.slice(1).map((review) => (
                <ReviewCard review={review} />
              ))}
            </div>
          )}
        </>
      ) : (
        <div class="card sand">
          <h2>Reviews are on the way.</h2>
          <p>Be the first to share your Iron Path experience. Submitted reviews are published after manual approval.</p>
        </div>
      )}
    </div>
  </section>

  <section class="section sand">
    <div class="container grid two" style="align-items: start;">
      <div>
        <div class="eyebrow">Submit a Review</div>
        <h2>Manual approval, <em>then publish.</em></h2>
        <p class="lead">Submitted reviews are routed to the team. After approval, they can be added to the live review list and customer highlights.</p>
        <div style="display: flex; gap: 12px; flex-wrap: wrap;">
          <a class="btn" href={externalLinks.googleReview} target="_blank" rel="noreferrer">Leave a Google Review</a>
          <a class="btn secondary" href={googleForms.customerReview} target="_blank" rel="noreferrer">Website Review Form</a>
        </div>
        <p class="fine-print">{googleFormFinePrint}</p>
      </div>
      <ContactForm type="review" title="Review Submission" intro="Your review will be sent for manual approval before it appears on the website." googleFormUrl={googleForms.customerReview} />
    </div>
  </section>
</BaseLayout>
