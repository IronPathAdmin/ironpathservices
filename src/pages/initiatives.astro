---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import GoogleFormLinks from '../components/GoogleFormLinks.astro';
import TallyEmbed from '../components/TallyEmbed.astro';
import TallyPopupButton from '../components/TallyPopupButton.astro';
import { initiatives, tallyForms } from '../data/site';
---

<BaseLayout title="Initiatives" description="Iron Path Services community initiatives: Green Initiative, Red Carpet Initiative, investment strategy, volunteer program, referral ecosystem, and SolarPunk vision.">
  <PageHero eyebrow="Initiatives" title="Service work with <em>roots.</em>" lead="The long-term commitments that make Iron Path more than a service company." />

  <section class="section">
    <div class="container grid three">
      {initiatives.map((initiative) => (
        <article class="card sand reveal">
          <h3>{initiative.title}</h3>
          <p>{initiative.summary}</p>
          <ul>
            {initiative.details.map((detail) => <li>{detail}</li>)}
          </ul>
          {initiative.title === 'Iron Path Volunteer Program' ? (
            <p style="margin-top: 16px;">
              <TallyPopupButton formKey="volunteerProgram" class="btn secondary" />
            </p>
          ) : initiative.title === 'Methow Valley Investment Strategy' ? (
            <p style="margin-top: 16px;">
              <TallyPopupButton formKey="communityNeed" class="btn secondary" />
            </p>
          ) : 'href' in initiative && initiative.href ? (
            <p style="margin-top: 16px;">
              <a class="btn secondary" href={initiative.href}>Book Karaoke &amp; Red Carpet</a>
            </p>
          ) : null}
        </article>
      ))}
    </div>
  </section>

  <section class="section dark">
    <div class="container grid two" style="align-items: center;">
      <div>
        <div class="eyebrow">Wildfire Safety</div>
        <h2>Safety is part of the <em>path.</em></h2>
        <p class="lead">Firewood Services, cleanup, and valley work all intersect with wildfire awareness. We will publish company-specific safety guidance before launch.</p>
      </div>
      <div class="card">
        <h3>What customers can do</h3>
        <ul>
          <li>Keep burnable material clear from structures.</li>
          <li>Use safe storage practices for firewood and paper products.</li>
          <li>Ask about cleanup options before fire season.</li>
          <li>Follow local burn bans and county guidance.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section sand" id="volunteer">
    <div class="container grid two" style="align-items: start;">
      <div>
        <div class="eyebrow">Volunteer Program</div>
        <h2>Serve the valley <em>with us.</em></h2>
        <p class="lead">
          The Iron Path Volunteer Program is for high schoolers, families, and neighbors who want
          real service work, events, and community outreach. Fill out the application and we will
          follow up about upcoming opportunities.
        </p>
        <div class="hero-actions" style="margin-top: 24px;">
          <TallyPopupButton formKey="volunteerProgram" class="btn" />
        </div>
        <p class="fine-print">{tallyForms.volunteerProgram.finePrint}</p>
      </div>
      <TallyEmbed formKey="volunteerProgram" />
    </div>
  </section>

  <section class="section" id="community-need">
    <div class="container grid two" style="align-items: start;">
      <div>
        <div class="eyebrow">Community Need</div>
        <h2>Know someone who could use a <em>hand?</em></h2>
        <p class="lead">
          Iron Path keeps an ongoing list of valley needs for Community Giving, sponsorship
          consideration, or a future volunteer day. Tell us what you are seeing and we will
          follow up.
        </p>
        <div class="hero-actions" style="margin-top: 24px;">
          <TallyPopupButton formKey="communityNeed" class="btn" />
        </div>
        <p class="fine-print">{tallyForms.communityNeed.finePrint}</p>
      </div>
      <TallyEmbed formKey="communityNeed" />
    </div>
  </section>

  <section class="section sand">
    <div class="container">
      <div class="eyebrow">Community Forms</div>
      <h2>Volunteer or submit a <em>community need.</em></h2>
      <GoogleFormLinks columns="two" titles={['Volunteer Program Application', 'Methow Valley Community Need Submission']} />
    </div>
  </section>
</BaseLayout>
