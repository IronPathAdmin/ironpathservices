---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---

<BaseLayout title="Local Businesses We Support" description="A launch-ready directory placeholder for Methow Valley businesses supported by Iron Path Services.">
  <PageHero eyebrow="Local Businesses" title="The Referral Ecosystem <em>starts here.</em>" lead="Business names are coming soon. This page is ready for the list once partnerships are confirmed." />

  <section class="section">
    <div class="container grid three">
      {Array.from({ length: 6 }).map((_, index) => (
        <article class="card sand reveal">
          <div class="placeholder-photo" style="min-height: 170px; margin-bottom: 18px;">Business logo/photo placeholder</div>
          <h3>Local Partner Slot {index + 1}</h3>
          <p>Placeholder for a Methow Valley business we support, why we recommend them, and how to contact them.</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
