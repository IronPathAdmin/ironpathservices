---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { googleFormFinePrint, googleForms } from '../data/site';
---

<BaseLayout title="Local Businesses We Support" description="Apply to join the Iron Path Services referral ecosystem for Methow Valley businesses.">
  <PageHero eyebrow="Local Businesses" title="Grow local trust <em>together.</em>" lead="We are building a practical referral network for Methow Valley businesses that share our standards for honest work, clear communication, and neighbor-first service." />

  <section class="section">
    <div class="container grid two" style="align-items: center;">
      <div>
        <div class="eyebrow">Now Accepting Partners</div>
        <h2>Want to become a <em>supported business?</em></h2>
        <p class="lead">
          Iron Path Services is building a local referral ecosystem: a practical network of
          Methow Valley businesses we can recommend when a neighbor needs the right fit.
        </p>
        <p>
          If your business serves the valley with honest work, clear communication, and community
          care, we invite you to apply. Approved partners may be featured with business details,
          contact links, and a short note about when we recommend them.
        </p>
        <a class="btn" href={googleForms.referralPartner} target="_blank" rel="noreferrer">
          Fill Out Referral Partner Application
        </a>
        <p class="fine-print">{googleFormFinePrint}</p>
      </div>
      <div class="card sand">
        <h3>Why apply?</h3>
        <ul>
          <li>Be considered for customer referrals when Iron Path is not the right fit</li>
          <li>Help neighbors find trusted, local options faster</li>
          <li>Share your service area, specialty, and best contact path</li>
          <li>Build a stronger valley network around clear standards</li>
          <li>Stay connected for future partnership opportunities</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section sand compact">
    <div class="container">
      <div class="eyebrow">How It Works</div>
      <h2>Apply, align, <em>get listed.</em></h2>
      <div class="grid three" style="margin-top: 28px;">
        <article class="card reveal">
          <h3>1. Apply</h3>
          <p>Fill out the Referral Partner Application with your business details and best contact information.</p>
        </article>
        <article class="card reveal">
          <h3>2. Connect</h3>
          <p>We review fit, values, availability, and how referrals should be handled between businesses.</p>
        </article>
        <article class="card reveal">
          <h3>3. Support Local</h3>
          <p>Approved partners are listed here so customers can discover trusted local options.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section sand compact">
    <div class="container" style="display: flex; justify-content: space-between; gap: 20px; align-items: center; flex-wrap: wrap;">
      <div>
        <div class="eyebrow">Referral Ecosystem</div>
        <h2>Want to be listed?</h2>
      </div>
      <a class="btn" href={googleForms.referralPartner} target="_blank" rel="noreferrer">
        Open Referral Partner Form
      </a>
      <p class="fine-print" style="flex-basis: 100%; text-align: right;">{googleFormFinePrint}</p>
    </div>
  </section>
</BaseLayout>
