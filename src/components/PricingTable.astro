---
interface Props {
  title?: string;
  columns: string[];
  rows: string[][];
}

const { title, columns, rows } = Astro.props;
---

{title && <h3 class="price-table-title">{title}</h3>}
<div class="table-wrap">
  <table>
    <thead>
      <tr>
        {columns.map((column) => <th>{column}</th>)}
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          {row.map((cell) => <td>{cell}</td>)}
        </tr>
      ))}
    </tbody>
  </table>
</div>
