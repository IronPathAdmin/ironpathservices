---
import { contact, googleFormFinePrint, services } from '../data/site';
import TallyPopupButton from './TallyPopupButton.astro';

interface Props {
  type?: 'quote' | 'review' | 'newsletter' | 'general' | 'volunteer' | 'evaluation' | 'image' | 'karaoke';
  title?: string;
  intro?: string;
  googleFormUrl?: string;
}

const {
  type = 'quote',
  title = 'Tell Us About Your Request',
  intro = 'Complete this form and we will prepare an organized email for you to review and send, or open the official Google Form when available.',
  googleFormUrl,
} = Astro.props;
---

<form
  class="form-box js-smart-form"
  data-form-type={type}
  data-leads-email={contact.leadsEmail}
  data-google-form={googleFormUrl}
>
  <h3>{title}</h3>
  <p style="color: var(--muted); line-height: 1.7;">{intro}</p>
  <div class="form-grid">
    <div class="field">
      <label for={`${type}-name`}>Full name</label>
      <input id={`${type}-name`} name="name" autocomplete="name" required />
    </div>
    <div class="field">
      <label for={`${type}-phone`}>Phone</label>
      <input id={`${type}-phone`} name="phone" autocomplete="tel" />
    </div>
    <div class="field">
      <label for={`${type}-email`}>Email</label>
      <input id={`${type}-email`} name="email" type="email" autocomplete="email" required />
    </div>
    <div class="field">
      <label for={`${type}-contact`}>Preferred contact</label>
      <select id={`${type}-contact`} name="preferred_contact">
        <option>Phone call</option>
        <option>Text message</option>
        <option>WhatsApp</option>
        <option>Email</option>
        <option>Any</option>
      </select>
    </div>

    {type === 'quote' && (
      <>
        <div class="field">
          <label for="quote-service">Service needed</label>
          <select id="quote-service" name="service" required>
            <option value="">Select a service</option>
            {services.map((service) => <option>{service.title}</option>)}
            <option>Multiple services</option>
            <option>Not sure yet</option>
          </select>
        </div>
        <div class="field">
          <label for="quote-date">Preferred date</label>
          <input id="quote-date" name="preferred_date" type="date" />
        </div>
        <div class="field full">
          <label for="quote-address">Service address</label>
          <input id="quote-address" name="address" placeholder="Street, city, state" required />
        </div>
      </>
    )}

    {type === 'review' && (
      <>
        <div class="field">
          <label for="review-rating">Star rating</label>
          <select id="review-rating" name="rating" required>
            <option>5 stars</option>
            <option>4 stars</option>
            <option>3 stars</option>
            <option>2 stars</option>
            <option>1 star</option>
          </select>
        </div>
        <div class="field">
          <label for="review-service">Service received</label>
          <input id="review-service" name="service_received" />
        </div>
      </>
    )}

    {type === 'karaoke' && (
      <>
        <div class="field">
          <label for="karaoke-interest">I am interested in</label>
          <select id="karaoke-interest" name="interest" required>
            <option value="">Select an option</option>
            <option>Karaoke hosting</option>
            <option>4-week recurring package</option>
            <option>Karaoke hosting + Red Carpet Moment</option>
            <option>Red Carpet Moment only</option>
            <option>Holiday or large event quote</option>
            <option>Just asking a question</option>
          </select>
        </div>
        <div class="field">
          <label for="karaoke-date">Preferred date</label>
          <input id="karaoke-date" name="preferred_date" type="date" />
        </div>
        <div class="field full">
          <label for="karaoke-location">Event location or venue</label>
          <input id="karaoke-location" name="preferred_location" placeholder="Address, venue, or town" />
        </div>
        <div class="field">
          <label for="karaoke-duration">Estimated duration</label>
          <select id="karaoke-duration" name="duration">
            <option value="">Select duration</option>
            <option>Up to 4 hours</option>
            <option>4-week package · 4 hrs/night</option>
            <option>4+ hours</option>
            <option>Holiday or large event</option>
            <option>Not sure yet</option>
          </select>
        </div>
        <div class="field">
          <label for="karaoke-guests">Approx. guest count</label>
          <input id="karaoke-guests" name="guest_count" placeholder="Optional" />
        </div>
      </>
    )}

    <div class="field full">
      <label for={`${type}-message`}>Message</label>
      <textarea id={`${type}-message`} name="message" required></textarea>
    </div>
  </div>

  <div class="form-note">
    This website does not store your submission. Your email app will open with the request
    addressed to {contact.leadsEmail}; review it and select Send.
    {googleFormUrl && ' For the official online intake, use the Google Form link below.'}
    {googleFormUrl && <span class="fine-print">{googleFormFinePrint}</span>}
    {type === 'quote' && (
      <span class="fine-print">
        If you select Secure Paper Shredding, the official Secure Paper Shredding Intake form will open instead.
      </span>
    )}
  </div>
  <div style="display: flex; gap: 12px; flex-wrap: wrap;">
    <button class="btn" type="submit">Open Organized Email</button>
    {type === 'quote' && <TallyPopupButton class="btn secondary" />}
    {googleFormUrl && (
      <a class="btn secondary" href={googleFormUrl} target="_blank" rel="noreferrer">
        Open Google Form
      </a>
    )}
  </div>
  <p class="status" role="status" aria-live="polite"></p>
</form>
