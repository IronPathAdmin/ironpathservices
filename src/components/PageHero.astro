---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<section class="page-hero">
  <div class="container">
    {eyebrow && <div class="eyebrow">{eyebrow}</div>}
    <h1 set:html={title} />
    {lead && <p class="lead">{lead}</p>}
  </div>
</section>
