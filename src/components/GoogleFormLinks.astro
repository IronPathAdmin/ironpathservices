---
import { formLinks, googleFormFinePrint } from '../data/site';
import TallyPopupButton from './TallyPopupButton.astro';

interface Props {
  titles?: string[];
  columns?: 'two' | 'three' | 'four';
}

const { titles, columns = 'four' } = Astro.props;
const links = titles?.length
  ? formLinks.filter((link) => titles.includes(link.title))
  : formLinks;
---

<div class={`grid ${columns}`}>
  {links.map((link) => (
    <article class="card sand reveal">
      <h3>{link.title}</h3>
      <p>{link.description}</p>
      {'provider' in link && link.provider === 'tally' ? (
        <>
          <TallyPopupButton class="btn secondary" label={link.ctaLabel} />
          <p class="fine-print">Opens the official Secure Document Shredding Request form. No Google login required.</p>
        </>
      ) : (
        <>
          <a class="btn secondary" href={link.href} target="_blank" rel="noreferrer">
            Open Google Form
          </a>
          <p class="fine-print">{googleFormFinePrint}</p>
        </>
      )}
    </article>
  ))}
</div>
